# Copy this file to .env.local for local development, and add the same
# variables in Vercel under Project Settings → Environment Variables for
# production.

# Your Google AdSense publisher ID (only set this AFTER you're approved).
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Leaving this blank keeps the site fully functional with no ad code loaded.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Optional: only needed if you verify Search Console via the "HTML tag"
# method instead of DNS verification. Paste just the content value Google
# gives you (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
